#!/usr/bin/env python3
"""Keep the open-source record and the pages that show it in step.

data/oss.yml is the record: one block per upstream project, one entry per pull
request a project's own maintainers merged. This script refreshes that file
from GitHub, then regenerates every place the numbers and lists appear:

  public/oss.html       stats, recent merges, every project and its PRs
  public/llms.txt       the one-line open-source fact
  public/llms-full.txt  the Open source section
  public/sitemap.xml    the /oss lastmod

Usage:
  bin/oss-sync            fetch new merged PRs from GitHub, then render
  bin/oss-sync --render   render from data/oss.yml only, no network
  bin/oss-sync --check    exit 1 if any file does not match data/oss.yml
  bin/oss-sync --full     re-fetch merged-by for every PR, not only new ones

Rules kept from the manual process: public repositories only; pull requests
authored by the account in meta.author; merged by the project's maintainers
(PRs in the author's own repositories, the repositories under
meta.excluded_repos and the PRs under meta.excluded_prs are left out).

data/oss.yml is written by this script. Hand-edit only `summary:`, `featured:`,
a project's `name`/`about`, and the meta text and exclusion lists; everything
else is refreshed from GitHub. Re-run with --render after editing.
"""

import datetime
import html
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, "data", "oss.yml")
PAGE = os.path.join(ROOT, "public", "oss.html")
LLMS = os.path.join(ROOT, "public", "llms.txt")
LLMS_FULL = os.path.join(ROOT, "public", "llms-full.txt")
SITEMAP = os.path.join(ROOT, "public", "sitemap.xml")
SITE = "https://www.wangyaodi.com"

# A project with at least MAJOR merged PRs gets its own row; smaller ones
# share the "Other projects" table. A major project with more than IN_PLACE
# PRs shows its featured ones (or the newest IN_PLACE) and links to the rest
# on GitHub.
MAJOR = 4
IN_PLACE = 5
RECENT = 10

HEADER = """\
# Open-source record for public/oss.html, the LLM files and the /oss lastmod.
#
# Written by bin/oss-sync. One block per upstream project, one entry per pull
# request merged by that project's maintainers. Do not hand-edit numbers,
# dates or titles. You may edit:
#   summary:        how one pull request reads (`code` renders as code)
#   featured: true  show the PR in place on its project and in llms-full.txt
#   name:/about:    how a project is named and described
#   meta text       description and llms_intro ({total}, {projects},
#                   {first}, {second} are filled in)
#   excluded_repos / excluded_prs ("owner/repo#123") to leave work out
# then run `bin/oss-sync --render`.
#
# Refresh from GitHub:  bin/oss-sync
# Verify before commit: bin/oss-sync --check   (also run by bin/check-site)
meta:"""

DEFAULT_DESCRIPTION = ("{total} pull requests merged upstream across {projects} Ruby and AI "
                       "projects, including {first} and {second} — reliability and integration work.")
DEFAULT_INTRO = "Most of the work is reliability and Rails integration."

PROJECT_KEYS = ("repo", "name", "about", "prs")
PR_KEYS = ("number", "merged", "title", "summary", "featured")
META_ORDER = ("author", "last_verified", "description", "llms_intro")
META_LISTS = ("excluded_repos", "excluded_prs")


class DataError(Exception):
    pass


# ─────────────────────────────  data file  ─────────────────────────────

def _scalar(v, where):
    v = v.strip()
    if not v:
        raise DataError(f"{where}: empty value")
    if v == "[]":
        return []
    if v.startswith('"'):
        try:
            return json.loads(v)
        except json.JSONDecodeError as e:
            raise DataError(f"{where}: bad quoted string ({e})")
    if v in ("true", "false"):
        return v == "true"
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    return v


def load_data(path=DATA):
    if not os.path.exists(path):
        raise SystemExit(f"{os.path.relpath(path, ROOT)} is missing; run bin/oss-sync to create it")
    meta, projects = {}, []
    mode, list_key, cur, cur_pr, in_prs = None, None, None, None, False
    for lineno, raw in enumerate(open(path, encoding="utf-8"), 1):
        line = raw.rstrip("\n")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        where = f"data/oss.yml:{lineno}"
        if indent == 0:
            if stripped == "meta:":
                mode = "meta"
            elif stripped == "projects:":
                mode = "projects"
            else:
                raise DataError(f"{where}: unexpected top-level line: {stripped}")
            continue
        if ":" not in stripped and not stripped.startswith("- "):
            raise DataError(f"{where}: expected key: value, got: {stripped}")
        if mode == "meta-list":
            if indent == 4 and stripped.startswith("- "):
                meta[list_key].append(_scalar(stripped[2:], where))
                continue
            mode = "meta"
        if mode == "meta":
            if indent != 2:
                raise DataError(f"{where}: unexpected indentation under meta")
            k, _, v = stripped.partition(":")
            if not v.strip():
                meta[k], list_key, mode = [], k, "meta-list"
            else:
                meta[k] = _scalar(v, where)
            continue
        if mode != "projects":
            raise DataError(f"{where}: line outside meta/projects")
        if indent == 2 and stripped.startswith("- "):
            cur = {"prs": []}
            projects.append(cur)
            cur_pr, in_prs = None, False
            k, _, v = stripped[2:].partition(":")
            if k not in PROJECT_KEYS:
                raise DataError(f"{where}: unknown project field: {k}")
            if k == "prs":
                in_prs = True
            else:
                cur[k] = _scalar(v, where)
            continue
        if cur is None:
            raise DataError(f"{where}: project field before any project")
        if indent == 4 and not in_prs:
            k, _, v = stripped.partition(":")
            if k == "prs":
                in_prs = True
                continue
            if k not in PROJECT_KEYS:
                raise DataError(f"{where}: unknown project field: {k}")
            cur[k] = _scalar(v, where)
            continue
        if not in_prs:
            raise DataError(f"{where}: expected prs: before pull requests")
        if indent in (6, 8):
            body = stripped
            if indent == 6:
                if not stripped.startswith("- "):
                    raise DataError(f"{where}: expected a pull request entry")
                cur_pr = {}
                cur["prs"].append(cur_pr)
                body = stripped[2:]
            elif cur_pr is None:
                raise DataError(f"{where}: pull request field before any pull request")
            k, _, v = body.partition(":")
            if k not in PR_KEYS:
                raise DataError(f"{where}: unknown PR field: {k}")
            cur_pr[k] = _scalar(v, where)
            continue
        raise DataError(f"{where}: unexpected indentation")
    for k in META_LISTS:
        meta.setdefault(k, [])
    # exclusions win over the record, so adding one takes effect on --render
    excluded = set(meta["excluded_prs"]) if isinstance(meta["excluded_prs"], list) else set()
    for p in projects:
        p["prs"] = [pr for pr in p["prs"] if f'{p.get("repo")}#{pr.get("number")}' not in excluded]
    if isinstance(meta["excluded_repos"], list):
        projects = [p for p in projects if p.get("repo") not in meta["excluded_repos"]]
    projects = [p for p in projects if p["prs"]]
    validate(meta, projects)
    return {"meta": meta, "projects": projects}


def validate(meta, projects):
    for k in ("author", "last_verified"):
        if not meta.get(k):
            raise DataError(f"data/oss.yml: meta.{k} is required")
    datetime.date.fromisoformat(str(meta["last_verified"]))
    for k in META_LISTS:
        if not isinstance(meta[k], list):
            raise DataError(f"data/oss.yml: meta.{k} must be a list")
    for ref in meta["excluded_prs"]:
        if not re.fullmatch(r"[\w.-]+/[\w.-]+#\d+", str(ref)):
            raise DataError(f'data/oss.yml: excluded_prs entry "{ref}" must look like owner/repo#123')
    seen = set()
    for p in projects:
        repo = p.get("repo")
        if not repo or "/" not in repo:
            raise DataError("data/oss.yml: every project needs a repo (owner/name)")
        if repo in seen:
            raise DataError(f"data/oss.yml: {repo} is listed twice")
        seen.add(repo)
        if not p.get("prs"):
            raise DataError(f"data/oss.yml: {repo} has no pull requests; remove the project instead")
        numbers = set()
        for pr in p["prs"]:
            if not isinstance(pr.get("number"), int):
                raise DataError(f"data/oss.yml: {repo} has a pull request without a number")
            ref = f"{repo}#{pr['number']}"
            if pr["number"] in numbers:
                raise DataError(f"data/oss.yml: {ref} is listed twice")
            numbers.add(pr["number"])
            if not pr.get("title"):
                raise DataError(f"data/oss.yml: {ref} has no title")
            if "featured" in pr and not isinstance(pr["featured"], bool):
                raise DataError(f"data/oss.yml: {ref} featured must be true or false")
            try:
                datetime.date.fromisoformat(str(pr.get("merged", "")))
            except ValueError:
                raise DataError(f"data/oss.yml: {ref} has an invalid merged date")


def _q(v):
    return json.dumps(str(v), ensure_ascii=False)


def dump_data(data):
    meta, projects = data["meta"], data["projects"]
    out = [HEADER]
    for k in META_ORDER:
        if meta.get(k):
            out.append(f"  {k}: {_q(meta[k])}")
    for k in META_LISTS:
        items = meta.get(k) or []
        if items:
            out.append(f"  {k}:")
            out.extend(f"    - {_q(v)}" for v in items)
        else:
            out.append(f"  {k}: []")
    out.append("projects:")
    for p in projects:
        out.append(f'  - repo: {_q(p["repo"])}')
        if p.get("name"):
            out.append(f'    name: {_q(p["name"])}')
        if p.get("about"):
            out.append(f'    about: {_q(p["about"])}')
        out.append("    prs:")
        for pr in p["prs"]:
            out.append(f'      - number: {pr["number"]}')
            out.append(f'        merged: {_q(pr["merged"])}')
            out.append(f'        title: {_q(pr["title"])}')
            if pr.get("summary"):
                out.append(f'        summary: {_q(pr["summary"])}')
            if pr.get("featured"):
                out.append("        featured: true")
    return "\n".join(out) + "\n"


# ─────────────────────────────  GitHub  ─────────────────────────────

def gh(args):
    r = subprocess.run(["gh"] + args, capture_output=True, text=True)
    if r.returncode:
        raise SystemExit(f"gh {' '.join(args)} failed:\n{r.stderr.strip()}")
    return r.stdout


def fetch_merged(meta, known, full):
    author = meta["author"]
    excluded = set(meta.get("excluded_repos") or [])
    excluded_prs = set(meta.get("excluded_prs") or [])
    raw = gh(["api", "--paginate",
              f"search/issues?q=author:{author}+is:pr+is:merged+is:public&per_page=100"])
    dec, i, items = json.JSONDecoder(), 0, []
    while i < len(raw):
        while i < len(raw) and raw[i].isspace():
            i += 1
        if i >= len(raw):
            break
        obj, i = dec.raw_decode(raw, i)
        items += obj.get("items", [])
    if not items:
        raise SystemExit("GitHub returned no merged pull requests; data/oss.yml left unchanged")

    found, skipped = {}, []
    for it in items:
        repo = it["repository_url"].split("/repos/", 1)[-1]
        owner = repo.split("/")[0]
        if owner == author or repo in excluded or f"{repo}#{it['number']}" in excluded_prs:
            skipped.append(f"{repo}#{it['number']}")
            continue
        found.setdefault(repo, []).append(it)
    if skipped:
        print(f"  left out {len(skipped)} pull request(s): own repositories, excluded repos or PRs")

    fresh = 0
    total_calls = sum(1 for repo, prs in found.items()
                      for it in prs if full or (repo, it["number"]) not in known)
    done = 0
    for repo, prs in sorted(found.items()):
        for it in prs:
            key = (repo, it["number"])
            if not full and key in known:
                continue
            done += 1
            if sys.stdout.isatty():
                print(f"  checking {repo}#{it['number']} ({done}/{total_calls})", end="\r", flush=True)
            elif done % 20 == 0:
                print(f"  checked {done}/{total_calls}")
            detail = json.loads(gh(["api", f"repos/{repo}/pulls/{it['number']}"]))
            merged_by = (detail.get("merged_by") or {}).get("login") or ""
            merged_at = (detail.get("merged_at") or "")[:10]
            if not merged_at:
                print(f"\n  {repo}#{it['number']} is not merged after all; left out")
                it["_skip"] = True
                continue
            if merged_by == author:
                print(f"\n  {repo}#{it['number']} was merged by {author} into {repo};"
                      f" if that is not a maintainer merge, add \"{repo}#{it['number']}\""
                      " to meta.excluded_prs")
            it["_merged"] = merged_at
            it["_title"] = detail.get("title") or it["title"]
            fresh += 1
    if total_calls:
        print()
    print(f"  {len(items)} public merged PRs found, {fresh} new or refreshed")
    return found


def describe(repo):
    try:
        d = json.loads(gh(["api", f"repos/{repo}"]))
    except SystemExit:
        return ""
    return (d.get("description") or "").strip()


def merge_data(data, found, full):
    """Fold the GitHub result into data/oss.yml, keeping hand-edited fields."""
    by_repo = {p["repo"]: p for p in data["projects"]}
    for repo, items in found.items():
        project = by_repo.get(repo)
        if project is None:
            project = {"repo": repo, "name": repo.split("/")[-1],
                       "about": describe(repo), "prs": []}
            data["projects"].append(project)
            by_repo[repo] = project
            print(f"  new project: {repo}")
        current = {pr["number"]: pr for pr in project["prs"]}
        for it in items:
            if it.get("_skip"):
                current.pop(it["number"], None)
                continue
            pr = current.get(it["number"])
            if pr is None:
                pr = {"number": it["number"], "merged": it["_merged"], "title": it["_title"]}
                project["prs"].append(pr)
                current[it["number"]] = pr
            elif full:
                pr["merged"] = it["_merged"]
                pr["title"] = it["_title"]

    # Pull requests no longer in GitHub's merged public list (unmerged, repo
    # made private or deleted, newly excluded) leave the record, whole
    # projects included.
    for project in data["projects"]:
        numbers = {it["number"] for it in found.get(project["repo"], []) if not it.get("_skip")}
        gone = [pr["number"] for pr in project["prs"] if pr["number"] not in numbers]
        if gone:
            print(f"  {project['repo']}: dropping {gone} (no longer in the merged public list)")
            project["prs"] = [pr for pr in project["prs"] if pr["number"] in numbers]
        project["prs"].sort(key=lambda p: (p["merged"], p["number"]), reverse=True)

    data["projects"] = [p for p in data["projects"] if p["prs"]]
    data["projects"].sort(key=lambda p: (-len(p["prs"]), p["repo"]))
    data["meta"]["last_verified"] = datetime.date.today().isoformat()
    return data


# ─────────────────────────────  rendering  ─────────────────────────────

CONVENTIONAL = re.compile(r"^(?:build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)"
                          r"(?:\([^)]*\))?!?:\s*", re.I)
EXT = 'target="_blank" rel="noopener"'


def clean_title(pr):
    t = CONVENTIONAL.sub("", pr["title"]).strip()
    if t:
        t = t[0].upper() + t[1:]
    return t or pr["title"]


def display(pr):
    """Plain text for the page: the summary, else the cleaned upstream title."""
    return pr.get("summary") or clean_title(pr)


def plain(pr):
    return display(pr).replace("`", "")


def mono(text):
    """Escape and turn `code` into the site's mono span."""
    text = html.escape(text, quote=False)
    return re.sub(r"`([^`]+)`", r'<span class="mono">\1</span>', text)


def project_name(p):
    return p.get("name") or p["repo"].split("/")[-1]


def years(prs):
    ys = [int(pr["merged"][:4]) for pr in prs]
    lo, hi = min(ys), max(ys)
    return str(lo) if lo == hi else f"{lo}–{hi}"


def total_prs(data):
    return sum(len(p["prs"]) for p in data["projects"])


def today(data):
    return datetime.date.fromisoformat(str(data["meta"]["last_verified"]))


def fmt_short(iso):
    d = datetime.date.fromisoformat(iso)
    return f"{d.day} {d.strftime('%b')}"


def fmt_long(iso):
    d = datetime.date.fromisoformat(iso)
    return f"{d.day} {d.strftime('%B')} {d.year}"


def merged_this_year(data):
    year = str(today(data).year)
    return sum(1 for p in data["projects"] for pr in p["prs"] if pr["merged"][:4] == year)


def all_prs(data):
    rows = [(p, pr) for p in data["projects"] for pr in p["prs"]]
    rows.sort(key=lambda r: (r[1]["merged"], r[1]["number"]), reverse=True)
    return rows


def featured(p):
    return [pr for pr in p["prs"] if pr.get("featured")]


def anchor(p):
    return "p-" + re.sub(r"[^a-z0-9]+", "-", p["repo"].split("/")[-1].lower()).strip("-")


def fill(template, data):
    projects = data["projects"]
    return template.format(
        total=total_prs(data), projects=len(projects),
        first=project_name(projects[0]),
        second=project_name(projects[1]) if len(projects) > 1 else "Rails gems")


def repo_prs_url(p):
    """The project's merged-PR filter on GitHub."""
    return f'https://github.com/{p["repo"]}/pulls?q=is%3Apr+author%3A{p["_author"]}+is%3Amerged'


def search_url(author, repos=()):
    """A GitHub search for the author's merged public PRs, optionally in some repos."""
    q = f"is%3Apr+is%3Amerged+is%3Apublic+author%3A{author}"
    q += "".join(f"+repo%3A{r.replace('/', '%2F')}" for r in repos)
    return f"https://github.com/search?q={q}&amp;type=pullrequests"


def pr_item(p, pr):
    return (f'<li><span class="ref"><a href="https://github.com/{p["repo"]}/pull/{pr["number"]}" {EXT}>'
            f'#{pr["number"]}</a></span><span class="what">{mono(display(pr))}</span></li>')


def pr_list(p, prs, pad):
    return ([f'{pad}<ul class="pr-list">']
            + [f"{pad}  {pr_item(p, pr)}" for pr in prs]
            + [f"{pad}</ul>"])


def project_head(p, tag, pad):
    n = len(p["prs"])
    lines = [f'{pad}<{tag} class="name"><a href="https://github.com/{p["repo"]}" {EXT}>'
             f'{html.escape(project_name(p))}</a></{tag}>',
             f'{pad}<p class="meta"><span class="count">{n} merged</span> · {years(p["prs"])} · '
             f'<a href="{repo_prs_url(p)}" {EXT}>{html.escape(p["repo"])}</a></p>']
    if p.get("about"):
        lines.append(f'{pad}<p class="about">{mono(p["about"])}</p>')
    return lines


def render_major(p):
    prs = p["prs"]
    out = [f'      <article class="oss-project reveal" id="{anchor(p)}">',
           '        <div class="p-side">']
    out += project_head(p, "h3", "          ")
    out += ['        </div>', '        <div class="p-list">']
    if len(prs) <= IN_PLACE:
        out += pr_list(p, prs, "          ")
    else:
        shown = featured(p) or prs[:IN_PLACE]
        label = "Selected" if featured(p) else "Newest"
        out.append(f'          <p class="pr-year">{label}</p>')
        out += pr_list(p, shown, "          ")
        out.append(f'          <p class="more mono"><a class="linked" href="{repo_prs_url(p)}" {EXT}>'
                   f'All {len(prs)} on GitHub &rarr;</a></p>')
    out += ['        </div>', '      </article>']
    return out


def render_minor(p):
    n = len(p["prs"])
    what = "".join(f'<span class="item">{mono(display(pr))}</span>' for pr in p["prs"])
    return [f'        <tr id="{anchor(p)}">'
            f'<th scope="row"><a href="https://github.com/{p["repo"]}" {EXT}>{html.escape(project_name(p))}</a></th>'
            f'<td class="what">{what}</td>'
            f'<td class="yr">{years(p["prs"])}</td>'
            f'<td class="n"><a href="{repo_prs_url(p)}" {EXT}>{n} PR{"s" if n != 1 else ""} &nearr;</a></td></tr>']


def split_projects(projects):
    major = [p for p in projects if len(p["prs"]) >= MAJOR]
    minor = sorted((p for p in projects if len(p["prs"]) < MAJOR), key=lambda p: p["repo"].lower())
    minor.sort(key=lambda p: max(pr["merged"] for pr in p["prs"]), reverse=True)
    return major, minor


def render(data):
    meta, projects = data["meta"], data["projects"]
    for p in projects:
        p["_author"] = meta["author"]
    n_total, n_projects = total_prs(data), len(projects)
    year = today(data).year
    first = min(int(pr["merged"][:4]) for p in projects for pr in p["prs"])
    flagship = projects[0]
    verified = fmt_long(meta["last_verified"])
    major, minor = split_projects(projects)

    out_stats = "\n".join([
        '    <div class="oss-stats reveal">',
        f'      <div class="cell"><div class="num">{n_total}</div><div class="lbl">PRs merged upstream</div></div>',
        f'      <div class="cell"><div class="num">{n_projects}</div><div class="lbl">upstream projects</div></div>',
        f'      <div class="cell"><div class="num">{merged_this_year(data)}</div><div class="lbl">merged in {year}</div></div>',
        f'      <div class="cell"><div class="num">{len(flagship["prs"])}</div><div class="lbl">into {html.escape(project_name(flagship))}</div></div>',
        '    </div>',
        f'    <p class="oss-note mono muted reveal">Verified on '
        f'<time datetime="{meta["last_verified"]}">{verified}</time> · '
        f'first upstream merge {first} · <a class="linked" href="#projects">by project &darr;</a></p>',
    ])

    recent = ['    <ul class="recent reveal">']
    for p, pr in all_prs(data)[:RECENT]:
        recent.append(
            f'      <li><time datetime="{pr["merged"]}">{fmt_short(pr["merged"])}</time>'
            f'<span class="what"><span class="where">{html.escape(project_name(p))}</span>'
            f'<a href="https://github.com/{p["repo"]}/pull/{pr["number"]}" {EXT}>'
            f'{mono(display(pr))}</a></span></li>')
    recent.append('    </ul>')
    out_recent = "\n".join(recent)

    proj = ['    <div class="oss-projects">']
    for p in major:
        proj += render_major(p)
    proj.append('    </div>')
    if minor:
        n_minor = sum(len(p["prs"]) for p in minor)
        proj += [f'    <h3 class="oss-h3 reveal">Other projects <span class="muted">· '
                 f'{len(minor)} projects, {n_minor} merged</span></h3>',
                 '    <div class="oss-table-wrap reveal">',
                 '      <table class="oss-table">',
                 '        <thead><tr><th scope="col">Project</th><th scope="col">What was merged</th>'
                 '<th scope="col">Year</th><th scope="col" class="n">GitHub</th></tr></thead>',
                 '        <tbody>']
        for p in minor:
            proj += render_minor(p)
        proj += ['        </tbody>', '      </table>', '    </div>',
                 f'    <p class="more mono reveal"><a class="linked" '
                 f'href="{search_url(meta["author"], [p["repo"] for p in minor])}" {EXT}>'
                 f'These {n_minor} on GitHub &rarr;</a></p>']
    proj.append(f'    <p class="oss-note mono muted reveal"><a class="linked" '
                f'href="{search_url(meta["author"])}" {EXT}>Every merged PR on GitHub &rarr;</a></p>')
    out_projects = "\n".join(proj)

    llms_line = (f'- Open source: {n_total} pull requests merged upstream as of {verified}, '
                 f'across {n_projects} upstream projects, including '
                 f'{len(flagship["prs"])} into {project_name(flagship)}'
                 + (f' and {len(projects[1]["prs"])} into {project_name(projects[1])}' if n_projects > 1 else "")
                 + f'. First upstream merge in {first}.')

    full = [f'As of {verified}, Andy has {n_total} pull requests merged upstream by project '
            f'maintainers, across {n_projects} projects, with the first upstream merge in {first}. '
            + fill(meta.get("llms_intro") or DEFAULT_INTRO, data), ""]
    for p in major:
        examples = [plain(pr) for pr in (featured(p) or p["prs"])[:3]]
        full.append(f'- {project_name(p)} ({p["repo"]}): {len(p["prs"])} merged PRs in {years(p["prs"])}, '
                    'for example: ' + "; ".join(examples) + '.')
    if minor:
        prs = [pr for p in minor for pr in p["prs"]]
        names = ", ".join(project_name(p) for p in minor)
        line = (f'- Other projects: {len(prs)} merged PRs across {len(minor)} projects '
                f'({names}), {years(prs)}')
        picks = [f'{plain(pr)} ({project_name(p)})' for p in minor for pr in featured(p)]
        full.append(line + (', including: ' + "; ".join(picks) if picks else "") + '.')

    return {
        "stats": out_stats,
        "recent": out_recent,
        "projects": out_projects,
        "llms_line": llms_line,
        "llms_full": "\n".join(full),
        "description": fill(meta.get("description") or DEFAULT_DESCRIPTION, data),
        "date": str(meta["last_verified"]),
    }


# ─────────────────────────────  file edits  ─────────────────────────────

def replace_region(text, name, body, where):
    start = f"<!-- oss:{name}:start -->"
    end = f"<!-- oss:{name}:end -->"
    if start not in text or end not in text:
        raise SystemExit(f"{where}: missing {start} … {end}; restore the markers")
    a = text.index(start) + len(start)
    b = text.index(end)
    return text[:a] + "\n" + body + "\n    " + text[b:]


def subst(pattern, repl, text, where, what, flags=re.S):
    new, n = re.subn(pattern, repl, text, count=1, flags=flags)
    if n != 1:
        raise SystemExit(f"{where}: could not find {what}")
    return new


def build(texts, data):
    """Return the expected content of every target file."""
    r = render(data)
    page = texts[PAGE]
    for region in ("stats", "recent", "projects"):
        page = replace_region(page, region, r[region], "public/oss.html")
    for attr in ('property="og:description"', 'name="twitter:description"'):
        page = subst(rf'(<meta {attr} content=")[^"]*(")',
                     lambda m: m.group(1) + html.escape(r["description"], quote=True) + m.group(2),
                     page, "public/oss.html", f"the {attr} meta")
    page = subst(r'("dateModified"\s*:\s*")[^"]*(")',
                 lambda m: m.group(1) + r["date"] + m.group(2),
                 page, "public/oss.html", 'the JSON-LD dateModified')

    llms = subst(r'(?m)^- Open source:[^\n]*$', lambda m: r["llms_line"], texts[LLMS],
                 "public/llms.txt", 'the "- Open source:" fact line', flags=re.M)
    full = subst(r'(?m)^#+ Open source\n\nSource: https://www\.wangyaodi\.com/oss\n\n.*?(?=\n#+ )',
                 lambda m: "## Open source\n\nSource: https://www.wangyaodi.com/oss\n\n" + r["llms_full"] + "\n",
                 texts[LLMS_FULL], "public/llms-full.txt", "the Open source section")
    # the /oss lastmod never goes backwards and is at least the verified date
    sitemap = subst(rf'(<loc>{re.escape(SITE)}/oss</loc>\s*<lastmod>)([^<]+)(</lastmod>)',
                    lambda m: m.group(1) + max(m.group(2), r["date"]) + m.group(3),
                    texts[SITEMAP], "public/sitemap.xml", "the /oss entry with a lastmod")
    return {PAGE: page, LLMS: llms, LLMS_FULL: full, SITEMAP: sitemap}


# ─────────────────────────────  main  ─────────────────────────────

def main():
    args = set(sys.argv[1:])
    unknown = args - {"--render", "--check", "--full", "-h", "--help"}
    if unknown or "-h" in args or "--help" in args:
        print(__doc__)
        return 0 if not unknown else 2
    if "--check" in args and "--render" in args:
        raise SystemExit("bin/oss-sync: use either --check or --render, not both")

    try:
        if os.path.exists(DATA) or args & {"--check", "--render"}:
            data = load_data()
        else:
            data = {"meta": {"author": "yorzi", "last_verified": datetime.date.today().isoformat(),
                             "excluded_repos": [], "excluded_prs": []}, "projects": []}
    except DataError as e:
        print(f"error: {e}")
        return 1
    if "--check" not in args and "--render" not in args:
        known = {(p["repo"], pr["number"]) for p in data["projects"] for pr in p["prs"]}
        print("Fetching merged pull requests from GitHub …")
        found = fetch_merged(data["meta"], known, "--full" in args)
        data = merge_data(data, found, "--full" in args)
        os.makedirs(os.path.dirname(DATA), exist_ok=True)
        with open(DATA, "w", encoding="utf-8") as f:
            f.write(dump_data(data))
        print(f"  wrote data/oss.yml ({total_prs(data)} merged PRs, {len(data['projects'])} projects)")

    texts = {p: open(p, encoding="utf-8").read() for p in (PAGE, LLMS, LLMS_FULL, SITEMAP)}
    expected = build(texts, data)
    changed = [p for p in expected if texts[p] != expected[p]]

    if "--check" in args:
        if changed:
            print("error: OSS files are out of step with data/oss.yml: "
                  + ", ".join(os.path.relpath(p, ROOT) for p in changed))
            print("       run bin/oss-sync --render (or bin/oss-sync to refresh from GitHub)")
            return 1
        print(f"OSS files match data/oss.yml ({total_prs(data)} merged PRs, {len(data['projects'])} projects)")
        return 0

    for path in changed:
        with open(path, "w", encoding="utf-8") as f:
            f.write(expected[path])
    print(f"  {total_prs(data)} merged PRs across {len(data['projects'])} projects; "
          f"{merged_this_year(data)} merged in {today(data).year}")
    print("  updated " + ", ".join(os.path.relpath(p, ROOT) for p in changed) if changed else "  no changes")
    return 0


if __name__ == "__main__":
    sys.exit(main())
