#!/usr/bin/env python3
"""Preview public/ locally the way Cloudflare Pages serves it.

/oss serves oss.html, and unknown paths get 404.html with a 404 status.
/_templates/post shows templates/post.html (local only, never deployed).
Binds to 127.0.0.1 only. Usage: bin/serve [port]   (default 8000, Ctrl-C to stop)
"""
import functools
import http.server
import os
import sys

REPO = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
ROOT = os.path.join(REPO, "public")
TEMPLATES = os.path.join(REPO, "templates")


class Handler(http.server.SimpleHTTPRequestHandler):
    def translate_path(self, path):
        if path.startswith("/_templates/"):
            name = os.path.basename(path.split("?", 1)[0].split("#", 1)[0])
            return os.path.join(TEMPLATES, name)
        return super().translate_path(path)

    def send_head(self):
        path = self.translate_path(self.path)
        if not os.path.exists(path) and os.path.isfile(path + ".html"):
            self.path = self.path.split("?", 1)[0].split("#", 1)[0] + ".html"
        elif not os.path.exists(path):
            self.send_response(404)
            body = open(os.path.join(ROOT, "404.html"), "rb").read()
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return None
        return super().send_head()


port = int(sys.argv[1]) if len(sys.argv) > 1 else 8000
server = http.server.ThreadingHTTPServer(("127.0.0.1", port), functools.partial(Handler, directory=ROOT))
print(f"Serving public/ at http://127.0.0.1:{port}/  (Ctrl-C to stop)")
try:
    server.serve_forever()
except KeyboardInterrupt:
    pass
