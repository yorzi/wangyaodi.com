#!/usr/bin/env python3
"""Preview public/ locally the way Cloudflare Pages serves it.

/oss serves oss.html, and unknown paths get 404.html with a 404 status.
/_templates/post shows templates/post.html (local only, never deployed).
Binds to 127.0.0.1 only. Usage: bin/serve [port]   (default 8000, Ctrl-C to stop)
"""
import functools
import http.server
import os
import sys
from urllib.parse import urlsplit

REPO = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
ROOT = os.path.join(REPO, "public")
TEMPLATES = os.path.join(REPO, "templates")
with open(os.path.join(ROOT, "_redirects"), encoding="utf-8") as rules:
    REDIRECTS = {}
    for line in rules:
        rule = line.partition("#")[0].strip()
        if rule:
            source, target, status = rule.split()
            REDIRECTS[source] = (target, int(status))


class Handler(http.server.SimpleHTTPRequestHandler):
    def translate_path(self, path):
        if path.startswith("/_templates/"):
            name = os.path.basename(path.split("?", 1)[0].split("#", 1)[0])
            return os.path.join(TEMPLATES, name)
        return super().translate_path(path)

    def send_head(self):
        parts = urlsplit(self.path)
        path = self.translate_path(self.path)
        redirect = REDIRECTS.get(parts.path)
        if not redirect and parts.path.endswith(".html") and os.path.isfile(path) and not parts.path.startswith("/_templates/"):
            clean = parts.path.removesuffix(".html")
            if parts.path.endswith("/index.html"):
                clean = clean.removesuffix("index")
            redirect = (clean, 308)
        if redirect:
            target, status = redirect
            self.send_response(status)
            self.send_header("Location", target + ("?" + parts.query if parts.query else ""))
            self.send_header("Content-Length", "0")
            self.end_headers()
            return None
        if not os.path.exists(path) and os.path.isfile(path + ".html"):
            self.path = self.path.split("?", 1)[0].split("#", 1)[0] + ".html"
        elif not os.path.exists(path):
            self.send_response(404)
            body = open(os.path.join(ROOT, "404.html"), "rb")
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(os.fstat(body.fileno()).st_size))
            self.end_headers()
            return body
        return super().send_head()


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8000
    with http.server.ThreadingHTTPServer(("127.0.0.1", port), functools.partial(Handler, directory=ROOT)) as server:
        print(f"Serving public/ at http://127.0.0.1:{port}/  (Ctrl-C to stop)")
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
